# Copy this file to misra_backend/.env and replace every placeholder.
# URL-encode special characters in the database username or password.
DB_URL=mysql+pymysql://misra_user:change-me@127.0.0.1:3306/misra_edu?charset=utf8mb4

# Create a key in Google AI Studio. Never commit the real value.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# One optional visual adjudication call per paper for questions the document-wide
# mapper cannot place. Leave false while Gemini quota is exhausted; enable after
# quota resets. This call uses the selected OCR_PROVIDER.
OCR_MAPPING_SECOND_PASS_ENABLED=false

# Optional free-model experiments and explicit free-only grading; keep the key private.
OPENROUTER_API_KEY=

# Explicit grading provider. Gemini remains the backwards-compatible baseline;
# openrouter_free verifies zero pricing and never falls back to paid/Gemini.
GRADING_PROVIDER=gemini
OPENROUTER_GRADING_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Three bounded AI stages. Set each provider explicitly to openrouter_free or local
# to run without Gemini. Pin a currently available image-capable :free model.
MISRA_AI_PROVIDER=gemini
OCR_PROVIDER=gemini
SETUP_PROVIDER=gemini
VERIFICATION_ENABLED=true
# Verification inherits GRADING_PROVIDER unless explicitly configured.
# VERIFICATION_PROVIDER=openrouter_free
# OCR_MODEL=qwen/qwen3.8-27b:free
# SETUP_MODEL=qwen/qwen3.8-27b:free
# VERIFICATION_MODEL=qwen/qwen3.8-27b:free
# GRADING_MODEL=qwen/qwen3.8-27b:free
# Mixed Gemini extraction + OpenRouter grading profile: docs/NATIVE_WORKSPACE.md
# Local Ollama/vLLM/llama.cpp OpenAI-compatible endpoint; model must be installed.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_VISION=false

# Source PDFs have a separate page ceiling; ordinary student limits are unchanged.
MAX_MATERIAL_PDF_PAGES=1000

# Approved-source retrieval. bm25_v1 preserves the established baseline.
# neural_hybrid_v1 = BM25 + local BGE-M3 embeddings + BGE reranker.
# bm25_rerank_v1 is the BM25 + reranker ablation. No provider/model fallback.
# dense_v1 = BGE-M3 cosine search; dense_rerank_v1 adds the BGE reranker.
# Both dense strategies omit BM25 entirely.
# Provision weights with misra_backend/scripts/setup_neural_retrieval.py --download.
MISRA_RETRIEVAL_STRATEGY=bm25_v1
MISRA_RETRIEVAL_DEVICE=cpu
# Optional absolute model directory; defaults to .local/neural-models in the repo.
# MISRA_NEURAL_MODEL_DIR=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOVERY_SIGNING_KEY=replace-with-a-random-secret

# Signs instructor session cookies. Generate independently from other keys.
AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters

# Use true only when the application is served over HTTPS.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API.
APP_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Displayed in health checks and Admin operations. CI can replace BUILD_SHA.
APP_VERSION=0.3.0
BUILD_SHA=local

# Upload boundary. Values are bytes except page/file counts.
MAX_UPLOAD_BYTES=26214400
MAX_BATCH_BYTES=104857600
MAX_BATCH_FILES=25
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=40000000

# Password recovery. Console mode writes the reset link to the backend log and
# is only for local development. Use smtp for a deployed installation.
APP_PUBLIC_URL=http://127.0.0.1:8000
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_WINDOW_MINUTES=60
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_DELIVERY=console

# Required when PASSWORD_RESET_DELIVERY=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Durable OCR and grading queues. Redis carries job IDs only; MariaDB stores
# the authoritative job status, progress, and failure details.
REDIS_URL=redis://127.0.0.1:6379/0
JOB_MAX_ATTEMPTS=3
JOB_RETRY_INTERVALS=10,30

# Startup orphan reconciliation. A queued/processing database job older than
# this is checked against Redis and safely requeued only when no live RQ job exists.
JOB_ORPHAN_AFTER_SECONDS=1800

# Audit events contain safe metadata only and are automatically pruned by the worker.
AUDIT_RETENTION_DAYS=180
